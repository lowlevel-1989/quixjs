# compilacion
/quixjs
*.o
# la cache de Python de los generadores de JavaScriptCore
__pycache__/

# bytecode compilado y logs de los tests
cache/

# juegos de terceros para probar en local: nunca van al repositorio
tmp/
games/*/gamedata/*
# la carpeta gamedata/ de quixjs en los tests (lo que escribe el juego)
games/tests/**/gamedata/
# lo que tests/run.sh copia dentro de cada test (el sandbox no deja salir)
games/tests/*/*/lib/
games/tests/*/*/assets/
games/tests/pixi_v4_webgl/*/rom/
# la rom de cada juego (su .zip o package.nw, junto a port.toml): la copia
# cada uno
games/*/*.zip
games/*/*.nw

# editores
.idea/
.vscode/
*.swp
*~

# dependencias y objetos de make PLATFORM=portmaster, y los .zip de los ports
obj/
*.zip
# make release
release/
# make bench (tools/h5bench.sh)
results/
# make PLATFORM=android: el .apk y las fuentes de SDL que descarga
*.apk
*.apk.idsig
/android/deps/
games/*/screenshots/
